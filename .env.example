# ==============================================================================
# Nestly — Environment Variables Template
# Copy this file to .env for local testing.
# In production (Render), configure these variables in the Render Dashboard.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
# Public API base URL (must include /api prefix)
# Development default: http://localhost:8080/api
# Production example: https://nestly-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# Backend Environment Variables (Spring Boot)
# ------------------------------------------------------------------------------
# PostgreSQL JDBC connection URL
# Development default: jdbc:postgresql://localhost:5432/nestly
# Production example: jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com/nestly_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nestly

# PostgreSQL Database Credentials
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# JWT Signing Secret (must be at least 256 bits / 32 characters for HMAC-SHA256)
# Generate a random 32+ character key: e.g. openssl rand -base64 32
JWT_SECRET=your_secure_256_bit_jwt_secret_must_be_at_least_32_characters_long

# Allowed Frontend Origins for CORS (comma-separated, no wildcards with credentials)
# Development default: http://localhost:5173
# Production example: https://nestly-frontend.onrender.com,http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server Port (automatically assigned by Render via $PORT)
PORT=8080
